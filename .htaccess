RewriteEngine On

# Core routing
RewriteRule ^admin/(.*)$ core/admin/$1 [L,QSA]
RewriteRule ^api/(.*)$ core/api/$1 [L,QSA]
RewriteRule ^pages/(.*)$ core/pages/$1 [L,QSA]
RewriteRule ^install/(.*)$ core/install/$1 [L,QSA]
RewriteRule ^resultat\.php$ core/resultat.php [L,QSA]

# Site-specific pages
RewriteRule ^prix-m2-bordeaux\.php$ site-specific/pages/prix-m2-bordeaux.php [L,QSA]
