# Sécurité
Options -Indexes
ServerSignature Off

# Protection des fichiers sensibles
<FilesMatch "\.(php|ini|log|sql|env)$">
    # Autoriser uniquement les PHP publics
</FilesMatch>

# Protéger le dossier config
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloquer accès direct aux includes
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^classes/ - [F,L]
    RewriteRule ^sql/ - [F,L]

    # URLs propres
    RewriteRule ^mentions-legales$ pages/mentions-legales.php [L]
    RewriteRule ^politique-confidentialite$ pages/politique-confidentialite.php [L]
    RewriteRule ^prix-m2/(.+)$ pages/prix-m2.php?ville=$1 [L]

    # Bloquer les bots malveillants
    RewriteCond %{HTTP_USER_AGENT} (wget|curl|libwww) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache navigateur
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
