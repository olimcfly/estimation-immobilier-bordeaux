ErrorDocument 404 /pages/404.php
ErrorDocument 500 /pages/500.php

RewriteEngine On
RewriteBase /

# Bloquer l'accès aux fichiers/dossiers sensibles
RewriteRule ^config\.php$ - [F,L,NC]
RewriteRule ^config/ - [F,L,NC]
RewriteRule ^sql/ - [F,L,NC]

# Bloquer l'installateur EstimIA une fois l'installation effectuée
RewriteCond %{DOCUMENT_ROOT}/estimia/installed.lock -f
RewriteRule ^estimia/install/ - [F,L,NC]

# Redirection propre des URLs vers .php si le fichier existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
